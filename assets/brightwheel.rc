#include "brightwheel-version.h"

1 ICON "brightwheel.ico"
2 ICON "brightwheel-bulb.ico"

1 VERSIONINFO
FILEVERSION BRIGHTWHEEL_VERSION_NUMERIC
PRODUCTVERSION BRIGHTWHEEL_VERSION_NUMERIC
FILEFLAGSMASK 0x3fL
FILEFLAGS BRIGHTWHEEL_VERSION_FLAGS
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "qqrm\0"
            VALUE "FileDescription", "BrightWheel\0"
            VALUE "FileVersion", BRIGHTWHEEL_VERSION_STRING
            VALUE "InternalName", "brightwheel\0"
            VALUE "OriginalFilename", "brightwheel.exe\0"
            VALUE "ProductName", "BrightWheel\0"
            VALUE "ProductVersion", BRIGHTWHEEL_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
